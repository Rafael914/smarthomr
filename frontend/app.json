{
  "expo": {
    "name": "SmartHome",
    "slug": "smarthome",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "scheme": "smarthome",

    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.rodelas187.smarthome"
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow SmartHome to access the microphone for voice commands.",
          "speechRecognitionPermission": "Allow SmartHome to recognize speech for voice commands."
        }
      ]
    ],

    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc5f32a4-b737-4c78-a17f-4e418fcc59e9"
      }
    },

    "owner": "rodelas187"
  }
}
